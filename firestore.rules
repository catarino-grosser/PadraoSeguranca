rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Lê o próprio perfil em users/{uid}. Chamadas repetidas a get() para
    // o mesmo caminho, dentro da mesma avaliação de regra, são cacheadas
    // pelo Firestore — não geram custo extra de leitura.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Um usuário com ativo:false não pode ser tratado como tendo papel
    // nenhum, mesmo que o token do Firebase Auth dele ainda seja válido
    // (desativar no Firestore não desativa a conta no Firebase Auth).
    function hasRole(role) {
      return isSignedIn()
        && myProfile().role == role
        && myProfile().ativo != false;
    }

    function isAdmin()     { return hasRole('adm'); }
    function isPorteiro()  { return hasRole('porteiro'); }
    function isVigilante() { return hasRole('vigilante'); }

    // ---------------------------------------------------------------
    // USERS — só o ADM pode listar/gerenciar funcionários.
    // Qualquer usuário autenticado pode ler o PRÓPRIO documento (é o que
    // auth.js faz logo após o login para descobrir o papel/vínculos).
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // ADM pode alterar qualquer campo. Qualquer usuário logado pode
      // atualizar o PRÓPRIO documento, mas só o campo fcmToken (usado pelo
      // push notification) — não pode se autopromover a admin nem mexer
      // em mais nada por essa via.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'atualizadoEm'])
        );
    }

    // ---------------------------------------------------------------
    // CONDOMINIOS / PORTARIAS — dados de baixa sensibilidade (nome,
    // endereço). Leitura liberada para qualquer usuário autenticado,
    // porque porteiro e vigilante precisam consultá-los para montar um
    // alerta / ver a rota. Escrita só pelo ADM.
    // ---------------------------------------------------------------
    match /condominios/{condId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /portarias/{portId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // ALERTAS — o coração da regra de negócio:
    //   - porteiro só enxerga (get/list) os PRÓPRIOS alertas. Isso exige
    //     que a consulta no app.js use where('porteiroId','==',uid);
    //     uma query sem esse filtro é recusada pelo Firestore.
    //   - vigilante e adm enxergam todos os alertas.
    //   - porteiro só cria alerta para o condomínio/portaria do PRÓPRIO
    //     perfil (impede forjar um alerta em nome de outro condomínio).
    //   - vigilante só pode aceitar um alerta "Aberto" (virando dono
    //     dele) ou finalizar um que ele mesmo aceitou.
    //   - porteiro só pode cancelar um alerta próprio que ainda está
    //     "Aberto".
    // ---------------------------------------------------------------
    match /alertas/{alertaId} {

      allow get, list: if isAdmin() || isVigilante()
                        || (isPorteiro() && resource.data.porteiroId == request.auth.uid);

      allow create: if isPorteiro()
                    && request.resource.data.porteiroId == request.auth.uid
                    && request.resource.data.condominioId == myProfile().condominioId
                    && request.resource.data.portariaId == myProfile().portariaId
                    && request.resource.data.status == 'Aberto'
                    && request.resource.data.vigilanteId == null
                    && request.resource.data.prioridade in ['Normal', 'Urgente', 'Crítico'];

      allow update: if isAdmin()
        || (
          isVigilante() && (
            // Aceitar um alerta aberto
            (resource.data.status == 'Aberto'
              && request.resource.data.status == 'Em atendimento'
              && request.resource.data.vigilanteId == request.auth.uid)
            ||
            // Finalizar um alerta que o próprio vigilante aceitou
            (resource.data.status == 'Em atendimento'
              && resource.data.vigilanteId == request.auth.uid
              && request.resource.data.status == 'Finalizado')
          )
        )
        || (
          // Cancelar o próprio alerta, só enquanto ainda está "Aberto"
          isPorteiro()
          && resource.data.porteiroId == request.auth.uid
          && resource.data.status == 'Aberto'
          && request.resource.data.status == 'Cancelado'
        );

      allow delete: if isAdmin();
    }
  }
}
